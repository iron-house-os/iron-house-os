POSTGRES_DB=iron_house_os
POSTGRES_USER=iron_house
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=jeremie@ironhousecontracting.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-login-password
BOOTSTRAP_ADMIN_NAME=Jeremie Peters
SESSION_COOKIE_SECURE=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
IHOS_STORAGE_BACKEND=local
IHOS_STORAGE_ROOT=/app/data/uploads
# S3-compatible storage (set IHOS_STORAGE_BACKEND=s3 and replace values below).
IHOS_STORAGE_S3_BUCKET=
IHOS_STORAGE_S3_PREFIX=iron-house-os
IHOS_STORAGE_S3_ENDPOINT_URL=
IHOS_STORAGE_CACHE_ROOT=/app/data/object-cache
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Off-host recovery bundles. This may be the document bucket or a separate private bucket.
IHOS_BACKUP_S3_BUCKET=
IHOS_BACKUP_S3_PREFIX=recovery-bundles
IHOS_BACKUP_RETENTION_DAYS=30
IHOS_BACKUP_KEEP_MINIMUM=7
IHOS_BACKUP_MAXIMUM_BUNDLES=60
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
IRON_HOUSE_CHAT_ENABLED=true
MEETING_MINUTES_ENABLED=true
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://os.ironhousecivil.com/api/v1/google-calendar/oauth/callback
GOOGLE_CALENDAR_FRONTEND_RETURN_URL=https://os.ironhousecivil.com/google-calendar
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
IHOS_TLS_EMAIL=jeremie@ironhousecontracting.com
IHOS_PORT=8080
