APP_ENV=production
APP_NAME=Iron House OS
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://iron_house:<strong-password>@<database-host>:5432/iron_house_os
SECRET_KEY=<minimum-64-character-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_HOSTS=<api-hostname>
CORS_ORIGINS=https://<frontend-hostname>

BOOTSTRAP_ADMIN_EMAIL=<admin-email>
BOOTSTRAP_ADMIN_PASSWORD=<temporary-strong-password>
BOOTSTRAP_ORGANIZATION_NAME=Iron House Civil Constructors

DOCUMENT_AUDIT_STORE=database
UPLOAD_MAX_BYTES=52428800

# Protected onboarding invitation delivery. Keep SMTP_PASSWORD outside source control.
ONBOARDING_EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=<approved-smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<approved-smtp-user>
SMTP_PASSWORD=<protected-smtp-password>
SMTP_FROM_EMAIL=<approved-company-sender>
SMTP_FROM_NAME=Iron House Contracting
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
