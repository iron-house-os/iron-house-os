# Copy to .env.staging on the staging host only. Never reuse production.env.
POSTGRES_DB=iron_house_os_staging
POSTGRES_USER=iron_house_staging
POSTGRES_PASSWORD=replace-with-a-staging-only-random-database-password
SECRET_KEY=replace-with-at-least-32-staging-only-random-characters
BOOTSTRAP_ADMIN_EMAIL=staging-admin@ironhousecontracting.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-staging-only-random-login-password
BOOTSTRAP_ADMIN_NAME=Iron House Staging Administrator
SESSION_COOKIE_NAME=ihos_staging_session
SESSION_COOKIE_SECURE=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_IP_MAX_FAILED_ATTEMPTS=20
LOGIN_LOCKOUT_MINUTES=15
BACKEND_CORS_ORIGINS=["https://staging.invalid"]
IHOS_STORAGE_BACKEND=local
IHOS_STORAGE_ROOT=/app/data/uploads
IHOS_STORAGE_CACHE_ROOT=/app/data/object-cache
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
IRON_HOUSE_CHAT_ENABLED=false
MEETING_MINUTES_ENABLED=true
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://staging.invalid/api/v1/google-calendar/oauth/callback
GOOGLE_CALENDAR_FRONTEND_RETURN_URL=https://staging.invalid/google-calendar
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
IHOS_STAGING_RELEASE_ID=unreleased
IHOS_STAGING_PORT=8081
VITE_PERFORMANCE_OBSERVABILITY_ENABLED=false
